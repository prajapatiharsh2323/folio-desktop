# Google Drive sync (optional at build time).
# Create a Desktop app OAuth client in Google Cloud Console with the Drive API
# enabled. The client ID can also be pasted at runtime in Settings → Cloud sync.
# See README.md → "Drive sync setup".
VITE_GOOGLE_CLIENT_ID=
# Desktop clients may issue a client secret; Google treats installed-app
# secrets as non-confidential, but never commit a real value.
VITE_GOOGLE_CLIENT_SECRET=
